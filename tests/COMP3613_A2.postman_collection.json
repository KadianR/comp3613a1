    {
      "name": "03 - Get Accommodation Listings",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Listings returned as JSON array', () => pm.expect(data).to.be.an('array'));",
              "pm.test('At least one available listing exists for workflow', () => pm.expect(data.length).to.be.greaterThan(0));",
              "pm.test('All returned listings are available', () => data.forEach(x => pm.expect(x.status).to.eql('available')));",
              "pm.test('Prices sorted low to high', () => {",
              "    for (let i=1;i<data.length;i++) pm.expect(Number(data[i].price_per_month)).to.be.at.least(Number(data[i-1].price_per_month));",
              "});",
              "if (data.length && data[0].id != null) pm.collectionVariables.set('listingId', String(data[0].id));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true,
        "followRedirects": true
