    {
      "name": "08 - View Landlord Booking Requests",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Runs BEFORE GET /api/landlord/requests. This is a hidden setup call,",
              "// not an extra visible request in the 12-request collection.",
              "const base = pm.variables.replaceIn('{{baseUrl}}').replace(/\\/$/, '');",
              "const landlordToken = pm.collectionVariables.get('landlordToken');",
              "const studentUsername = pm.collectionVariables.get('studentUsername');",
              "if (!landlordToken || !studentUsername) {",
              "    throw new Error('Run 02 - Student Login and 07 - Landlord Login first, and configure studentUsername');",
              "}",
              "pm.sendRequest({",
              "    url: base + '/api/_a2/fixture-bookings',",
              "    method: 'POST',",
              "    header: {",
              "        'Content-Type': 'application/json',",
              "        'Cookie': 'access_token=' + landlordToken",
              "    },",
              "    body: {",
              "        mode: 'raw',",
              "        raw: JSON.stringify({ student_username: studentUsername })",
              "    }",
              "}, function (err, res) {",
              "    if (err) throw new Error('A2 fixture setup failed: ' + err);",
              "    if (!res || res.code !== 201) {",
              "        throw new Error('A2 fixture setup returned ' + (res ? res.code : 'no response') +",
              "            ': ' + (res ? res.text() : '') +",
              "            '. Check that the local-only helper is installed and enabled.');",
              "    }",
              "    const fixture = res.json();",
              "    const mapping = {",
              "        fixtureListingId: 'fixture_listing_id',",
              "        approvalBookingId: 'approval_booking_id',",
              "        declineBookingId: 'decline_booking_id',",
              "        completedBookingId: 'completed_booking_id'",
              "    };",
              "    Object.entries(mapping).forEach(([variable, field]) => {",
              "        if (fixture[field] == null) throw new Error('Fixture missing ' + field);",
              "        pm.collectionVariables.set(variable, String(fixture[field]));",
              "    });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Landlord requests are an array', () => pm.expect(data).to.be.an('array'));",
              "pm.test('Fresh approval request is pending and visible', () => {",
              "    const id = pm.collectionVariables.get('approvalBookingId');",
              "    pm.expect(data.some(b => String(b.id) === id && b.status === 'pending')).to.eql(true);",
              "});",
              "pm.test('Fresh decline request is pending and visible', () => {",
              "    const id = pm.collectionVariables.get('declineBookingId');",
              "    pm.expect(data.some(b => String(b.id) === id && b.status === 'pending')).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true,
        "followRedirects": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{landlordToken}}",
