    {
      "name": "01 - Health Check",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A full run starts clean; retain user-supplied credentials.",
              "for (const key of [",
              "    'studentToken', 'landlordToken', 'listingId', 'bookingId',",
              "    'approvalBookingId', 'declineBookingId', 'completedBookingId',",
              "    'fixtureListingId'",
              "]) pm.collectionVariables.unset(key);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Health endpoint is OK', () => pm.expect(pm.response.json().ok).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Existing GET /health route. No authentication needed."
      },
      "response": []
    },
