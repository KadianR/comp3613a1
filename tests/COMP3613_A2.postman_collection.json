    {
      "name": "05 - Submit Booking Request",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const day = new Date();",
              "const fmt = d => d.toISOString().slice(0,10);",
              "const s=new Date(Date.UTC(day.getUTCFullYear(),day.getUTCMonth(),day.getUTCDate()+2));",
              "const e=new Date(Date.UTC(day.getUTCFullYear(),day.getUTCMonth(),day.getUTCDate()+32));",
              "pm.collectionVariables.set('startDate',fmt(s));",
              "pm.collectionVariables.set('endDate',fmt(e));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));",
              "const data=pm.response.json();",
              "pm.test('Booking is pending',()=>pm.expect(data.status).to.eql('pending'));",
              "pm.test('Booking uses selected accommodation',()=>pm.expect(String(data.accommodation_id)).to.eql(pm.collectionVariables.get('listingId')));",
              "pm.test('Booking ID returned',()=>pm.expect(data.id).to.be.a('number'));",
              "if(data.id!=null)pm.collectionVariables.set('bookingId',String(data.id));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true,
        "followRedirects": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{studentToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
