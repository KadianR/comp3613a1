          "raw": "{\n  \"accommodation_id\": \"{{listingId}}\",\n  \"start_date\": \"{{startDate}}\",\n  \"end_date\": \"{{endDate}}\",\n  \"message\": \"Assignment 2 Postman test booking\"\n}",
